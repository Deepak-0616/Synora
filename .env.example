# ====================================================================
# SYNORA: Environment Configuration Template
# ====================================================================

# Port for Backend REST API
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Authentication & Security
JWT_SECRET=synora-super-secret-jwt-key-aicte-2026-production-grade
JWT_EXPIRES_IN=7d

# Database Configuration
# Option A: Local Persistent Relational SQLite (Zero-config, ready out of the box)
DATABASE_MODE=sqlite
SQLITE_DB_PATH=./data/synora.db

# Option B: Supabase / PostgreSQL (Uncomment and configure if using Supabase or Postgres)
# DATABASE_MODE=postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[SERVER_ONLY_SERVICE_ROLE_KEY]

# AI Service Configuration (Optional)
# If AI API key is not provided, SYNORA uses its built-in rule-based AI engine for classification,
# duplicate detection, and summarization with zero downtime and 100% determinism.
# AI_PROVIDER=openai # or gemini, local
# AI_API_KEY=your-api-key-here
AI_PROVIDER=local

# Email Delivery Provider (Optional)
# In-app notifications are active by default. If SMTP is configured, emails are dispatched.
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-pass
# SMTP_FROM="SYNORA Grievance Portal" <no-reply@synora.aicte.gov.in>

# Logging
LOG_LEVEL=info

# --------------------------------------------------------------------
# FRONTEND CONFIGURATION (apps/web/.env)
# --------------------------------------------------------------------
# VITE_API_URL=http://localhost:4000/api/v1
# VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
# VITE_SUPABASE_ANON_KEY=[PUBLIC_ANON_KEY]
